# Auto-ATS Environment Configuration (Example)
# Copy this file to .env and fill in your own provider settings.

# --- LLM Provider (OpenAI-compatible endpoint) ---
FREELLM_URL=http://localhost:3001/v1
FREELLM_API_KEY=your-api-key-here

# --- Optional overrides ---
# FREELLM_MODEL=auto

# --- ATS Gate ---
ATS_GATE_THRESHOLD=35.0
ATS_GATE_MIN_SIGNAL=5.0
AI_ENGINE_TIMEOUT=120

# --- Resilience ---
STRIKE_MAX_RETRIES=3
STRIKE_RETRY_BACKOFF=1.5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_SECONDS=60
CIRCUIT_COOLDOWN_SECONDS=30

# --- Paths ---
AUTOATS_DB=/path/to/auto-ats/jobs.db
AUTOATS_TARGETS=/path/to/auto-ats/targets

# --- Web UI ---
LOCAL_WEBUI_PORT=5000
